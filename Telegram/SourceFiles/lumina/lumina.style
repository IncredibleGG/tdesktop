using "ui/basic.style";
using "ui/chat/chat.style";
using "ui/widgets/widgets.style";
using "info/info.style";
using "settings/settings.style";

// Dual-language display: what the user wrote is the main text at the normal
// message size, and the translation sits beneath it a size smaller. The size
// difference is the point of the feature, so it is expressed here rather than
// borrowed from an unrelated widget's style, which would silently follow that
// widget the next time upstream changes it.
luminaTranslationTextStyle: TextStyle(defaultTextStyle) {
	font: font(12px);
}

// The same relationship in the composer's send preview, which paints with a
// font rather than a TextStyle.
luminaPreviewOriginalFont: semiboldFont;
luminaPreviewTranslationFont: font(12px);

// Spun in place of the preview's translate glyph while a translation is on its
// way - the one for the text as typed, or the one a held Send is waiting on -
// so a slow provider reads as "working", not as a composer that stopped
// responding. Sized to the glyph it stands in for, in the accent colour the
// "Translating..." line beside it uses.
luminaPreviewBusy: InfiniteRadialAnimation(defaultInfiniteRadialAnimation) {
	color: windowActiveTextFg;
	thickness: 2px;
	size: size(18px, 18px);
}

// The per-chat translate button in the chat top bar. It stands in the same row
// as the call, search and info buttons, so it inherits topBarSearch and changes
// nothing but the glyph: the 40x54 hit area, the ripple and the colours have to
// be the ones its neighbours use, or it reads as a foreign control dropped into
// that row. The glyph is the one the chat menu's translate row already draws,
// so the two entry points onto the same switch look like the same feature.
//
// iconPosition is recomputed rather than inherited because that glyph is 24px
// where the top bar's own icons are 32px; inheriting topBarSearch's (4px, 11px)
// would hang it up and to the left of every button beside it.
luminaTopBarTranslate: IconButton(topBarSearch) {
	icon: icon {{ "menu/translate", menuIconFg }};
	iconOver: icon {{ "menu/translate", menuIconFgOver }};
	iconPosition: point(8px, 15px);
}

// The same glyph in the accent colour, shown while this chat is being
// translated - the treatment topBarInfoActive already gives the info button.
luminaTopBarTranslateActive: icon {{ "menu/translate", windowActiveTextFg }};

// A settings row that states a fact and cannot be pressed. Stock's right-hand
// label is windowActiveTextFg, the same accent every PRESSABLE value row on
// the LuminaGram pages uses - provider, API key, both languages - so a fact
// drawn with it reads as a control that ignores clicks, which is worse than
// something that plainly is not one. This spells the value out as ordinary
// secondary text instead.
luminaSettingsFactRow: SettingsButton(settingsButtonNoIcon) {
	rightLabel: FlatLabel(defaultSettingsRightLabel) {
		textFg: windowSubTextFg;
	}
}
