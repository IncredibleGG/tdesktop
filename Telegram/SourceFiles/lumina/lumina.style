using "ui/basic.style";
using "ui/chat/chat.style";
using "ui/widgets/widgets.style";
using "info/info.style";
using "settings/settings.style";

// Dual-language display: what the user wrote is the main text at the normal
// message size, and the translation sits beneath it a size smaller. The size
// difference is the point of the feature, so it is expressed here rather than
// borrowed from an unrelated widget's style, which would silently follow that
// widget the next time upstream changes it.
luminaTranslationTextStyle: TextStyle(defaultTextStyle) {
	font: font(12px);
}

// The same relationship in the composer's send preview, which paints with a
// font rather than a TextStyle.
luminaPreviewOriginalFont: semiboldFont;
luminaPreviewTranslationFont: font(12px);

// Spun in place of the preview's translate glyph while a translation is on its
// way - the one for the text as typed, or the one a held Send is waiting on -
// so a slow provider reads as "working", not as a composer that stopped
// responding. Sized to the glyph it stands in for, in the accent colour the
// "Translating..." line beside it uses.
luminaPreviewBusy: InfiniteRadialAnimation(defaultInfiniteRadialAnimation) {
	color: windowActiveTextFg;
	thickness: 2px;
	size: size(18px, 18px);
}

// The per-chat translate button in the chat top bar. It stands in the same row
// as the call, search and info buttons, so it inherits topBarSearch and changes
// nothing but the glyph: the 40x54 hit area, the ripple and the colours have to
// be the ones its neighbours use, or it reads as a foreign control dropped into
// that row. The glyph is the one the chat menu's translate row already draws,
// so the two entry points onto the same switch look like the same feature.
//
// iconPosition is recomputed rather than inherited because that glyph is 24px
// where the top bar's own icons are 32px; inheriting topBarSearch's (4px, 11px)
// would hang it up and to the left of every button beside it.
luminaTopBarTranslate: IconButton(topBarSearch) {
	icon: icon {{ "menu/translate", menuIconFg }};
	iconOver: icon {{ "menu/translate", menuIconFgOver }};
	iconPosition: point(8px, 15px);
}

// The same glyph in the accent colour, shown while this chat is being
// translated - the treatment topBarInfoActive already gives the info button.
luminaTopBarTranslateActive: icon {{ "menu/translate", windowActiveTextFg }};

// A settings row that states a fact and cannot be pressed. Stock's right-hand
// label is windowActiveTextFg, the same accent every PRESSABLE value row on
// the LuminaGram pages uses - provider, API key, both languages - so a fact
// drawn with it reads as a control that ignores clicks, which is worse than
// something that plainly is not one. This spells the value out as ordinary
// secondary text instead.
luminaSettingsFactRow: SettingsButton(settingsButtonNoIcon) {
	rightLabel: FlatLabel(defaultSettingsRightLabel) {
		textFg: windowSubTextFg;
	}
}

// The profile details block (lumina_profile_rows.cpp). LuminaGram's value rows
// (ID, creation / registration date, data centre) and its two action rows
// (Group Settings, Recent Actions) share one icon column with the upstream
// rows that carry an icon - the shared-media and action buttons: a 32px icon
// slot at x = 20px with the text at x = 79px. The padding is the labelled-row
// padding (infoProfileLabeledPadding) moved over to infoProfileButton's 79px
// text column, the same move upstream's own personal-channel row makes.
luminaProfileIconRowPadding: margins(79px, 9px, 20px, 7px);
luminaProfileIconRowIconLeft: 20px;

// Height of that slot. A value row centres the slot vertically on the row
// rather than pinning it at a fixed y, so the icon stays centred when a long
// label wraps onto a second line (lumina_profile_rows.cpp, AddIconInfoRow).
luminaProfileIconRowIconSlot: 32px;

// The glyphs are 24px menu icons dropped into that 32px info slot, so each one
// carries the point(4px, 4px) offset upstream gives every menu glyph it puts
// there (infoIconSettings, infoIconMediaChannel); without it the glyph sits
// 4px up and to the left of its neighbours'. infoIconFg is the colour those
// neighbours draw with.
luminaInfoIconGroupSettings: icon {{ "menu/settings", infoIconFg, point(4px, 4px) }};
luminaInfoIconRecentActions: icon {{ "menu/show_in_chat", infoIconFg, point(4px, 4px) }};
luminaInfoIconId: icon {{ "menu/info", infoIconFg, point(4px, 4px) }};
luminaInfoIconDate: icon {{ "menu/calendar", infoIconFg, point(4px, 4px) }};
luminaInfoIconDc: icon {{ "menu/devices", infoIconFg, point(4px, 4px) }};

// LuminaGram #23: the floating formatting bar above the composer
// (lumina_format_bar.cpp). A pill of 32px buttons carrying upstream's own
// rich-text glyphs (Resources/icons/menu/rich, the ones the Instant View
// editor toolbar shows) in the colour every menu glyph uses; the pill, its
// outline and its shadow are the editor's pill (Dialogs::PaintPillBackground,
// ivEditorPillShadow's values).
luminaFormatBarButtonSize: 32px;
luminaFormatBarButton: IconButton(defaultIconButton) {
	width: luminaFormatBarButtonSize;
	height: luminaFormatBarButtonSize;
	iconPosition: point(-1px, -1px);
	rippleAreaPosition: point(0px, 0px);
	rippleAreaSize: luminaFormatBarButtonSize;
	ripple: defaultRippleAnimationBgOver;
}
luminaFormatBarPadding: 4px;
luminaFormatBarGroupSkip: 9px;
luminaFormatBarDividerMargin: 10px;
luminaFormatBarShadow: BoxShadow {
	blurRadius: 3px;
	offset: point(0px, 1px);
	opacity: 0.09;
}

// Kept this far from the host's sides, and this far above the top of the
// compose stack (reply / edit bar and translate preview included).
luminaFormatBarSkip: 8px;
luminaFormatBarOffset: 8px;

luminaFormatBarBold: icon {{ "menu/rich/bold-24x24", menuIconColor }};
luminaFormatBarItalic: icon {{ "menu/rich/italic-24x24", menuIconColor }};
luminaFormatBarUnderline: icon {{ "menu/rich/underline-24x24", menuIconColor }};
luminaFormatBarStrikeOut: icon {{ "menu/rich/strikeout-24x24", menuIconColor }};
luminaFormatBarMonospace: icon {{ "menu/rich/code-24x24", menuIconColor }};
luminaFormatBarSpoiler: icon {{ "menu/rich/spoiler-24x24", menuIconColor }};
luminaFormatBarQuote: icon {{ "menu/rich/blockquote-24x24", menuIconColor }};
luminaFormatBarLink: icon {{ "menu/rich/link-24x24", menuIconColor }};
luminaFormatBarClear: icon {{ "menu/rich/plain_text-24x24", menuIconColor }};
